# Copy this file to .env and fill in your values.
# The .env file is in .gitignore — NEVER commit it to GitHub.

# ── Django ────────────────────────────────────────────────────────
SECRET_KEY=your-django-secret-key
DEBUG=True

# ── Email (Gmail SMTP) ────────────────────────────────────────────
# Use a Google App Password, not your account password.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# ── Twilio (WhatsApp notifications) ───────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=whatsapp:+14155238886
TWILIO_TO_NUMBER=whatsapp:+10000000000

# ── SLA hours per priority level (tune without touching code) ─────
SLA_HIGH_HOURS=4
SLA_MODERATE_HOURS=24
SLA_LOW_HOURS=72

# ── Power BI reporting feed ───────────────────────────────────────
# Shared key for /api/v1/powerbi/tickets/. Power BI's scheduled refresh
# cannot complete an interactive login, so this endpoint is key-authenticated
# rather than session-authenticated. Generate a long random string.
POWERBI_API_KEY=generate-a-long-random-string

# ── Working hours for turnaround time (TAT) ───────────────────────
WORK_START_HOUR=9
WORK_END_HOUR=18
# 0 = Monday ... 6 = Sunday
WORK_DAYS=0,1,2,3,4

# ── Support mailbox: emails sent here become tickets ──────────────
# Use a Gmail address with IMAP on and a Google App Password.
# Then run:  python manage.py fetch_mail --every 60
SUPPORT_IMAP_HOST=imap.gmail.com
SUPPORT_IMAP_USER=
SUPPORT_IMAP_PASSWORD=
# Only these sender domains raise tickets directly; others wait for an Admin.
# Leave empty to accept any sender who has an account.
SUPPORT_ALLOWED_DOMAINS=
