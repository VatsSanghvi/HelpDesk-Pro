# ── Secrets — NEVER commit these ──────────────────────────────────
.env
*.env

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Django ────────────────────────────────────────────────────────
db.sqlite3
db.sqlite3-journal
*.log
local_settings.py
staticfiles/
media/

# ── Virtual environments ──────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Power BI (.pbip project) ───────────────────────────────────────
# Local cache Power BI Desktop regenerates on every open - not source,
# just repo bloat if tracked.
*.abf
# Power BI Desktop per-machine UI state (window positions, last-open page).
# Regenerated on every open - noise in diffs, not source.
**/.pbi/localSettings.json


# ── Claude Code local MCP config (machine-specific paths) ──────────
.mcp.json

# ── IDE / OS ──────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
*.swp
*.swo

# ── Stitch design scratch — preview only, not part of the app ──────
design-preview/*
!design-preview/README.md

# /brag — keep the source assets (real screenshots, feed data, render
# pipeline: see brag-output/work/README.md) so future video edits don't
# require re-capturing from the running app. Only the reconstructable /
# throwaway build output is ignored.
brag-output/work/cdn/
brag-output/work/netcache/
brag-output/work/stills/
brag-output/work/final/
brag-output/work/*.mp4
brag-output/work/*_noaudio.*
brag-output/work/music.wav
brag-output/work/comp_built.html
brag-output/work/sheet*.jpg
brag-output/work/final_sheet.jpg
brag-output/work/check_f*.jpg
brag-output/work/poster_src.jpg
brag-output/work/render.log
